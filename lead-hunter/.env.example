# Copia este archivo como  .env  y pega tus claves.
# Las dos que siguen son GRATIS y NINGUNA pide tarjeta de credito.

# 1) Google Gemini — quien analiza los perfiles y escribe los mensajes.
#    Sacala en https://aistudio.google.com/apikey  (entras con tu Gmail, listo)
#    Plan gratuito real: sin tarjeta, sin vencimiento.
GEMINI_API_KEY=

# 2) Apify — quien entra a LinkedIn a buscar los perfiles.
#    Sacala en https://console.apify.com/settings/integrations  (pestana API)
#    Plan gratuito: 5 USD de credito por mes, sin tarjeta. Alcanza para ~600 leads.
APIFY_TOKEN=


# --- Opcionales: solo si algun dia decidis pagar. NO hacen falta. -------------
